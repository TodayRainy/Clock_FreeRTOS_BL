set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

find_program(ARM_GCC arm-none-eabi-gcc REQUIRED)
find_program(ARM_OBJCOPY arm-none-eabi-objcopy REQUIRED)
find_program(ARM_SIZE arm-none-eabi-size REQUIRED)

set(CMAKE_C_COMPILER "${ARM_GCC}" CACHE FILEPATH "ARM GCC compiler")
set(CMAKE_ASM_COMPILER "${ARM_GCC}" CACHE FILEPATH "ARM GCC assembler")
set(CMAKE_OBJCOPY "${ARM_OBJCOPY}" CACHE FILEPATH "ARM objcopy")
set(CMAKE_SIZE "${ARM_SIZE}" CACHE FILEPATH "ARM size")

# 不在主机路径中搜索目标端的头文件和库，避免误链接 Windows 运行库。
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

